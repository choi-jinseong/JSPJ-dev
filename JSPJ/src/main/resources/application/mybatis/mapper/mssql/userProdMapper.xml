<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.JSPJ.demo.Mapper.userProdMapper">

	<resultMap id="registMap" type="com.JSPJ.demo.Vo.businessVo">
		<result column="REGIST_ID"				property="registId" />			<!-- 프로그램 아이디 					-->
		<result column="REGIST_NAME"			property="registNm" />			<!-- 프로그램 아이디 					-->
		<result column="COMPANY_CD"      		property="companyCd" />			<!-- 프로그램 경로	 				-->
		<result column="COMPANY_NAME"      		property="companyNm" />			<!-- 프로그램 경로	 				-->
		<result column="MANAGER_ID"        		property="managerId" />				<!-- 프로그램명칭 						-->
		<result column="MANAGER_NAME"        	property="managerNm" />				<!-- 프로그램명칭 						-->
		<result column="MANAGER_EMAIL"        	property="managerEmail" />				<!-- 프로그램명칭 						-->
		<result column="MANAGER_TELNO"        	property="managerTelNo" />				<!-- 프로그램명칭 						-->
		<result column="PRODUCT_NAME"        	property="productNm" />				<!-- 사용유무 						-->
		<result column="PRODUCT_CNT"        	property="productCnt" />				<!-- 사용유무 						-->
		<result column="PRODUCT_CATEGORY"       property="productCategory" />				<!-- 사용유무 						-->
		<result column="PRODUCT_DESC"        	property="productDesc" />				<!-- 사용유무 						-->
		<result column="PRICE"        			property="price" />				<!-- 사용유무 						-->
		<result column="STATE"        			property="state" />				<!-- 사용유무 						-->
		<result column="FILE_NAME"        		property="fileName" />				<!-- 사용유무 						-->
		<result column="FILE_PATH"        		property="filePath" />				<!-- 사용유무 						-->
		<result column="CREATED_AT"        		property="createAt" />				<!-- 사용유무 						-->
	</resultMap>
	

	<!-- 상품목록 조회 -->
	<select id="selectProductList" parameterType="String" resultMap="registMap">
		SELECT REGIST_ID			-- 등록아이디 
		      , REGIST_NAME			--등록명
			  , PRODUCT_NAME          -- 제품명
              , PRICE                           -- 가격
              , STATE 					-- 상태
              , FILE_NAME
              , FILE_PATH
		FROM REGIST_INFO
		<!-- WHERE STATE = 'A' -->
	</select>
	
	<!-- 상품 상세정보 -->
	<select id="selectProdDetail" parameterType="String" resultMap="registMap">
		SELECT REGIST_ID
				, COMPANY_CD
				, COMPANY_NAME
				, PRODUCT_NAME
				, PRODUCT_CNT
				, PRODUCT_CATEGORY
				, PRODUCT_DESC
				, PRICE
				, FILE_PATH
		FROM REGIST_INFO
		WHERE REGIST_ID = #{registId}
	</select>
	
	<!-- 상품결제 저장 -->
	<insert id="insProductBuyList" parameterType="com.JSPJ.demo.Vo.businessVo">
		INSERT INTO ORDER_INFO
		 (
     	  USER_ID
     	  ,USERNAME
     	  ,PRODUCT_NAME
     	  ,ADDRESS
     	  ,ADDRESS_DETAIL
     	  ,ORDER_KIND
     	  ,PRODUCT_CNT
     	  ,PRICE
     	  ,STATE
     	  ,DELIVERY_DATE
		)
		VALUES
		(
		 #{userId}
		 ,#{userName}
		 ,#{productNm}
		 ,#{address}
		 ,#{detailAddress}
		 ,#{productCnt}
		 ,#{totalOrder}
		 ,#{state}
		 ,#{deliveryDate}
		)
	</insert>
	
	<!-- 상품 갯수 수정 -->
	<update id="updProdInfo" parameterType="com.JSPJ.demo.Vo.businessVo">
		UPDATE REGIST_INFO SET  
			, PRODUCT_CNT = #{productCnt}
			, UPDATED_AT = GETDATE()
		WHERE REGIST_ID = #{registId}
	</update>

	
</mapper>